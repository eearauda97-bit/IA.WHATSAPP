# Banco de dados (Supabase, Railway, ou Postgres local)
DATABASE_URL="postgresql://usuario:senha@host:5432/lista_espera"

# NextAuth
NEXTAUTH_SECRET="gere-com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# WhatsApp Cloud API (Meta)
# Obtidos no Meta for Developers -> seu App -> WhatsApp -> API Setup
WHATSAPP_TOKEN="token-de-acesso-permanente-da-meta"
WHATSAPP_PHONE_NUMBER_ID="id-do-numero-de-telefone"
WHATSAPP_VERIFY_TOKEN="crie-uma-string-secreta-qualquer-para-validar-o-webhook"
WHATSAPP_API_VERSION="v20.0"
